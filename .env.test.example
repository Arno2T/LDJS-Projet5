# Test database connection string — points to the dedicated Docker container
# used by the test suite (tests/), never the dev database.
# See README.md "Base de données de test" for the docker run command.
DATABASE_URL="postgresql://user:password@localhost:5433/mdd_db_test?schema=public"

# Any value works for tests — sessions created in tests are signed/verified
# with this secret, never shared with a real environment.
JWT_SECRET="test-secret-key"
